<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Meilisearch</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-*" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-*" />
    <PackageReference Include="Jellyfin.Common" Version="12.0.0-*" />
  </ItemGroup>

  <!-- Meilisearch SDK -->
  <ItemGroup>
    <PackageReference Include="Meilisearch" Version="0.18.0" />
  </ItemGroup>

  <!--
    Local embedding model for semantic search. ONNX Runtime brings a native library per platform;
    CopyLocalLockFileAssemblies lays the runtimes/ tree out next to the plugin assembly so the
    P/Invoke resolves inside Jellyfin's plugin load context.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration/configPage.html" />
  </ItemGroup>

  <PropertyGroup>
    <OnnxRuntimeAllPlatforms>linux-x64;linux-arm64;osx-arm64;win-x64;win-arm64</OnnxRuntimeAllPlatforms>
    <OnnxRuntimeBuildPlatforms Condition="'$(OnnxRuntimeBuildPlatforms)' == ''">$(NETCoreSdkRuntimeIdentifier)</OnnxRuntimeBuildPlatforms>
    <OnnxRuntimeBuildPlatforms Condition="'$(OnnxRuntimeBuildPlatforms)' == ''">linux-x64</OnnxRuntimeBuildPlatforms>
    <OnnxRuntimePublishPlatforms Condition="'$(OnnxRuntimePublishPlatforms)' == ''">$(OnnxRuntimeAllPlatforms)</OnnxRuntimePublishPlatforms>

    <!-- Set by the staging target's re-entrant build; a plain evaluation wants every platform. -->
    <OnnxNativePlatforms Condition="'$(OnnxNativePlatforms)' == ''">$(OnnxRuntimeAllPlatforms)</OnnxNativePlatforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source path relative to the output root, paired with where it is staged to. -->
    <OnnxRuntimeNative Include="runtimes/linux-x64/native/libonnxruntime.so"
                       Condition="$(OnnxNativePlatforms.Contains('linux-x64'))">
      <StagedPath>native/linux-x64/libonnxruntime.so</StagedPath>
    </OnnxRuntimeNative>
    <OnnxRuntimeNative Include="runtimes/linux-arm64/native/libonnxruntime.so"
                       Condition="$(OnnxNativePlatforms.Contains('linux-arm64'))">
      <StagedPath>native/linux-arm64/libonnxruntime.so</StagedPath>
    </OnnxRuntimeNative>
    <OnnxRuntimeNative Include="runtimes/osx-arm64/native/libonnxruntime.dylib"
                       Condition="$(OnnxNativePlatforms.Contains('osx-arm64'))">
      <StagedPath>native/osx-arm64/libonnxruntime.dylib</StagedPath>
    </OnnxRuntimeNative>
    <OnnxRuntimeNative Include="runtimes/win-x64/native/onnxruntime.dll"
                       Condition="$(OnnxNativePlatforms.Contains('win-x64'))">
      <StagedPath>native/win-x64/onnxruntime.nativelib</StagedPath>
    </OnnxRuntimeNative>
    <OnnxRuntimeNative Include="runtimes/win-arm64/native/onnxruntime.dll"
                       Condition="$(OnnxNativePlatforms.Contains('win-arm64'))">
      <StagedPath>native/win-arm64/onnxruntime.nativelib</StagedPath>
    </OnnxRuntimeNative>
  </ItemGroup>

  <Target Name="StageOnnxRuntimeNativesInBuildOutput" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="StageOnnxRuntimeNatives"
             Properties="OnnxNativeStageRoot=$(OutDir);OnnxNativePlatforms=$(OnnxRuntimeBuildPlatforms);TargetFramework=$(TargetFramework)" />
  </Target>

  <Target Name="StageOnnxRuntimeNativesInPublishOutput" AfterTargets="Publish">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="StageOnnxRuntimeNatives"
             Properties="OnnxNativeStageRoot=$(PublishDir);OnnxNativePlatforms=$(OnnxRuntimePublishPlatforms);TargetFramework=$(TargetFramework)" />
  </Target>

  <Target Name="StageOnnxRuntimeNatives">
    <ItemGroup>
      <OnnxNativeToStage Include="@(OnnxRuntimeNative)" Condition="Exists('$(OnnxNativeStageRoot)%(Identity)')" />
    </ItemGroup>

    <RemoveDir Directories="$(OnnxNativeStageRoot)native" ContinueOnError="true" />

    <Copy SourceFiles="@(OnnxNativeToStage->'$(OnnxNativeStageRoot)%(Identity)')"
          DestinationFiles="@(OnnxNativeToStage->'$(OnnxNativeStageRoot)%(StagedPath)')" />
    <RemoveDir Directories="$(OnnxNativeStageRoot)runtimes" ContinueOnError="true" />
  </Target>
</Project>
